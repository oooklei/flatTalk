# ==================== flatTalk 环境变量配置模板 ====================
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件包含敏感信息，请勿提交到版本控制

# ==================== 基础服务配置 ====================
FLATTALK_HOST=0.0.0.0
FLATTALK_PORT=5298
FLATTALK_RUNTIME_MODE=local

# ==================== LIS 意图门控（SHOULD：默认开启）====================
# 留空或 1=开启；0/false=关闭并回退 scene-router
LIS_GATE_ENABLED=1
LIS_BASE_URL=http://127.0.0.1:8100

# ==================== HTTPS 配置（用于话筒等安全上下文功能）====================
# HTTPS 端口（前端访问）
FLATTALK_SSL_PORT=5444
# SSL 证书路径（容器内路径）
FLATTALK_SSL_KEY=/app/ssl/server.key
FLATTALK_SSL_CERT=/app/ssl/server.crt

# ==================== 数据库配置（PostgreSQL / Redis，远程 10.21.202.9）====================
# 直连 tag-system 业务库（与 Tag-System 共用，存 service_order / work_order / feedback 等表）
# 远程 tag-system-postgres-1 容器，host 端口 55432，容器内 5432
FLATTALK_TAG_SYSTEM_PG_URL=postgresql://tag_system:ab42be71d048cd4c1e387fd154d88ecd1985017466b4a942@10.21.202.9:55432/tag_system
# 兼容别名：部分服务与 scripts/migrate_biz_tables.py 优先读取此变量（应与上面保持一致）
FLATTALK_PG_URL=postgresql://tag_system:ab42be71d048cd4c1e387fd154d88ecd1985017466b4a942@10.21.202.9:55432/tag_system

# Redis（远程 tag-system-redis-1 容器，host 端口 56379，密码 123456）
FLATTALK_REDIS_URL=redis://:123456@10.21.202.9:56379/7

# ==================== 标签系统（Tag-System）配置 ====================
# Tag-System 后端 API 地址（tag-system-backend-1 容器，host 端口 8010）
FLATTALK_TAG_SYSTEM_BASE_URL=http://10.21.202.9:8010
# 是否启用标签系统直连：部署到 160 时设为 true；本地开发连不上 160 时设为 false 走本地兜底
ENABLE_TAG_SYSTEM=true
# API 密钥认证（文档：请求头 X-API-Key: tk_live_...）。勿将真实密钥提交到 git。
FLATTALK_TAG_SYSTEM_API_KEY=
# 兼容旧名（若仅配置了 TOKEN，适配器也会当作 API Key 使用）
FLATTALK_TAG_SYSTEM_TOKEN=
TAG_SYSTEM_SSO_TOKEN=
TAG_SYSTEM_CLIENT_KEY=
# Context Bus 登录校正：1=用 Tag HTTP API 校正实体；0=仅 SSO provisional
FLATTALK_TAG_CORRECTOR=0
# Tag 校正超时（毫秒）
FLATTALK_TAG_CORRECT_TIMEOUT_MS=2500
# Context Bus 会话抽取/注入：默认开启；设 0 关闭
FLATTALK_CONTEXT_BUS=1
# 抽取意图覆盖 LIS/scene 路由（默认关）
FLATTALK_INTENT_EXTRACT_OVERRIDE=0

# ==================== 知识库配置（gxy-local-kb，远程服务）====================
# 本地 SQLite 知识库已弃用，全部走远程 gxy-local-kb 服务
# 开发：FLATTALK_KB_BASE_URL=http://192.168.1.2:9016
# 生产：FLATTALK_KB_BASE_URL=http://gxy-local-kb:9016
FLATTALK_KB_BASE_URL=http://<kb-host>:9016
FLATTALK_KB_SEARCH_PATH=/api/knowledge/query
FLATTALK_KB_API_KEY=<your-api-key>
FLATTALK_KB_TICKET=<your-ticket>
FLATTALK_KB_USERNAME=<username>
FLATTALK_KB_PASSWORD=<password>
FLATTALK_KB_SPACE=23
FLATTALK_KB_AGENT_ID=373
FLATTALK_KB_MEAL_PLAN_COLLECTIONS=膳食知识库
FLATTALK_KB_DEFAULT_COLLECTIONS=广西养老办事指引知识库,广西养老政策知识库
FLATTALK_KB_TIMEOUT_MS=5000
# 强制远程模式：禁用进程内本地知识库（SQLite），全部走 gxy-local-kb
FLATTALK_KB_REMOTE_ONLY=1

# ==================== 模型配置 ====================
FLATTALK_MODEL_MODE=admin
# 生产禁止 mock；仅演示设 FLATTALK_ALLOW_MODEL_MOCK=1
# FLATTALK_ALLOW_MODEL_MOCK=1
FLATTALK_MODEL_REGISTRY_PATH=
FLATTALK_MODEL_ID=
FLATTALK_OPENAI_BASE_URL=
FLATTALK_OPENAI_API_KEY=
FLATTALK_OPENAI_MODEL=

# 模型密钥（按供应商）
# 注意：LLM 密钥主要存储在 data/model-registry.json，通过 Admin 面板管理。
# 以下环境变量为可选覆盖（优先级：registry.json > 以下变量 > 通用回退）。
# registry.json 中已配置的模型，此处留空即可。
FLATTALK_MODEL_ZHIPU_API_KEY=
FLATTALK_MODEL_DASHSCOPE_API_KEY=
FLATTALK_MODEL_OPENAI_API_KEY=
# 通用回退密钥（当 registry 和供应商变量都为空时使用）
FLATTALK_MODEL_API_KEY=

# 语义 enrichment LLM 超时（毫秒），超时走 rules_fallback
FLATTALK_SEMANTIC_TIMEOUT_MS=1200

# ==================== SHOULD 诚实失败闸门 ====================
# 质量本地缓存 / 目录种子 / 嘉路默认定位 / 演示老人（生产 FLATTALK_RUNTIME_MODE=production 时默认禁演示老人）
# FLATTALK_ALLOW_LOCAL_QUALITY_CACHE=1
# FLATTALK_ALLOW_CATALOG_SEED=1
# FLATTALK_ALLOW_DEFAULT_LOCATION=1
# FLATTALK_ALLOW_MOCK_ELDERS=0

# ==================== 金跳动旅居产品 API ====================
# P0：生产用 real；仅联调演示可设 mock。auto 未配置密钥时不再静默 mock。
JTD_API_MODE=real
JTD_BASE_URL=https://lvjutest.jtdcn.cn
JTD_PATH_PREFIX=/jtd-applet/ai/sojourn
JTD_TENANT_ID=042788
JTD_AI_APP_ID=ai_test_app
JTD_AI_APP_SECRET=<your-app-secret>
JTD_TIMEOUT_MS=15000

# 演示仿真（质量/天气/Tavily）。生产勿开；默认关闭。
# FLATTALK_ALLOW_SIM_FALLBACK=1
# FLATTALK_DISABLE_SIM_FALLBACK=1

# 旅居产品 API（兼容配置）
TRAVEL_PRODUCT_API_BASE_URL=https://lvjutest.jtdcn.cn
TRAVEL_PRODUCT_API_APP_ID=ai_test_app
TRAVEL_PRODUCT_API_APP_SECRET=<your-app-secret>
TRAVEL_ORDER_API_BASE_URL=
JTD_H5_BASE_URL=
JTD_MINI_PROGRAM_APPID=

# ==================== 腾讯地图和天气服务 ====================
# WebService API Key（SK类型，需签名验证，后端调用用）
TENCENT_MAP_KEY=<your-tencent-map-ws-key>
TENCENT_MAP_SK=<your-tencent-map-sk>
# 备用 WebService Key（主 Key 日配额 120/121 耗尽时自动切换；填入后生效）
TENCENT_MAP_KEY_2=<your-tencent-map-ws-key-2>
TENCENT_MAP_SK_2=<your-tencent-map-sk-2>
# JavaScript API Key（前端地图渲染用，不需签名；勿当作 KEY_2）
TENCENT_MAP_JS_KEY=<your-tencent-map-js-key>
# 腾讯天气接口（实时天气 / 多日预报）
TENCENT_WEATHER_BASE_URL=https://apis.map.qq.com
# 旅居线路 SVG：丘陵底图 → Seedream 图生图（1=开，0=仅地理底图）
FLATTALK_ROUTE_MAP_AI=1
FLATTALK_ROUTE_MAP_AI_TIMEOUT_MS=120000

# ==================== 云诊365配置 ====================
YZ365_BASE_URL=http://171.111.198.212:9013
YZ365_PATH=/stage-api/sd/yz365/checkDetail
YZ365_APP_KEY=
YZ365_APP_SECRET=

# ==================== 云诊舌诊/面诊检测报告配置 ====================
# 与云诊365并列的健康风险数据源（GET /openapi/shezhen/reports）
SHEZHEN_SECRET=sign_U9IAnIMAFv
SHEZHEN_API_URL=https://aiyl-m.yunxida.com/backend-api/portal-api
SHEZHEN_USER_ID=user001
SHEZHEN_USER_IDS=user001
SHEZHEN_TIMEOUT_MS=10000

# ==================== 和风天气配置 ====================
QWEATHER_BASE_URL=https://devapi.qweather.com
QWEATHER_API_KEY=

# ==================== 语音服务配置 ====================
ASR_ENDPOINT=http://<asr-host>:8020/api/v1/asr/sentence

# ==================== 认证配置 ====================
UNIFIED_AUTH_BASE_URL=
UNIFIED_AUTH_APP_KEY=
UNIFIED_AUTH_APP_SECRET=

# ==================== 数据库配置（MySQL）====================
GXY_MYSQL_HOST=<mysql-host>
GXY_MYSQL_PORT=3306
GXY_MYSQL_USER=<mysql-user>
GXY_MYSQL_PASSWORD=<mysql-password>
GXY_MYSQL_DATABASE=<mysql-database>

# ==================== Redis配置 ====================
GXY_REDIS_HOST=<redis-host>
GXY_REDIS_PORT=6379
GXY_REDIS_PASSWORD=
GXY_REDIS_DB=0

# ==================== 老人画像配置 ====================
PROFILE_TAG_BASE_URL=
PROFILE_TAG_APP_KEY=
PROFILE_TAG_APP_SECRET=
ELDER_PROFILE_API_BASE_URL=

# ==================== Tavily搜索配置 ====================
TAVILY_API_KEY=

