{
  "packageKey": "guixiaoyang_dispatch",
  "templateProfile": "in-chat-template-rendering-v1",
  "pathPolicy": "package-relative-only-for-runtime-and-remote-deploy",
  "runtimeRoot": ".",
  "remoteResources": {
    "tables": [
      "gxy_dispatch_session"
    ],
    "knowledgeBases": [
      "guixiaoyang_dispatch_business_kb"
    ],
    "agentBoundKnowledgeBases": [
      "guixiaoyang_policy_kb"
    ]
  },
  "globalConventions": {
    "conventionsDoc": "docs/superpowers/specs/2026-07-24-global-skill-conventions.md",
    "redisDB": 1,
    "bffPrefix": "/api/dispatch-agent/*",
    "dialogueHistoryDB": 0,
    "dialogueTable": "gxy_dialogue_history"
  },
  "bffConfig": {
    "host": "192.168.1.2",
    "port": 5443,
    "protocol": "https",
    "integratedIn": "main-system-server.js",
    "renderContract": "guixiaoyang.render-document.v1"
  }
}
