{
  "slot_preferences": [
    {
      "slot_key": "summary-card",
      "required": true,
      "allowed_actions": []
    },
    {
      "slot_key": "meal-section",
      "required": true,
      "allowed_actions": [
        "meal_plan.regenerate"
      ]
    },
    {
      "slot_key": "nutrition-note",
      "required": true,
      "allowed_actions": []
    },
    {
      "slot_key": "related-questions",
      "required": false,
      "allowed_actions": [
        "meal_plan.regenerate",
        "meal_plan.confirm",
        "meal_plan.order_handoff"
      ]
    }
  ],
