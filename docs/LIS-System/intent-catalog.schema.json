{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiCare.local/flattalk/schemas/intent-catalog.schema.json",
  "title": "FlatTalkIntentCatalog",
  "description": "flatTalk 侧 Intent 功能包对口描述目录。Matcher 用本目录与 LIS IntentSupply 做匹配；intent_id 为唯一执行键。",
  "type": "object",
  "required": ["catalog_version", "intents"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": {
      "type": "string",
      "description": "目录版本，热更新时递增"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "intents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/intent_package" }
    }
  },
  "$defs": {
    "intent_package": {
      "type": "object",
      "required": ["intent_id", "intent_desc", "entry"],
      "additionalProperties": false,
      "properties": {
        "intent_id": {
          "type": "string",
          "minLength": 1,
          "description": "原子意图 ID，与 LIS 输出 intents[].intent_id 对齐"
        },
        "intent_desc": {
          "type": "string",
          "description": "对口自然语言描述，供匹配/embedding"
        },
        "examples": {
          "type": "array",
          "items": { "type": "string" },
          "description": "典型用户说法"
        },
        "domain": {
          "type": ["string", "null"],
          "description": "可选软标签（原 skill/scene 分组）；不硬过滤"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "多维标签，替代 Category"
        },
        "slots_schema": {
          "type": "object",
          "properties": {
            "required": {
              "type": "array",
              "items": { "type": "string" }
            },
            "optional": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "composability": {
          "type": "object",
          "properties": {
            "parallel_ok": { "type": "boolean", "default": false },
            "serial_after": {
              "type": "array",
              "items": { "type": "string" },
              "description": "允许串在这些 intent 之后"
            }
          },
          "additionalProperties": false
        },
        "entry": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["template", "action", "handler"]
            },
            "skill_key": { "type": "string" },
            "template_id": { "type": "string" },
            "action_key": { "type": "string" },
            "handler": { "type": "string" }
          }
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "match_hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keywords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "embedding_text": { "type": "string" }
          }
        }
      }
    }
  }
}
